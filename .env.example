# Browser-exposed configuration. Never add service-role or other server secrets here.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_URL=http://127.0.0.1:8001
VITE_SITE_URL=http://localhost:5173

# Backend configuration. This project currently uses the same restricted anon key.
# Do not place a service-role key in any VITE_* variable.
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SPORTAI_MAX_UPLOAD_BYTES=104857600
