# Browser-exposed configuration. Never add service-role or other server secrets here.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Local development default. Set this to https://sportai-dashboard-1.onrender.com
# in the Vercel Production environment.
VITE_API_BASE_URL=https://sportai-dashboard-1.onrender.com
VITE_SITE_URL=http://localhost:5173

# Backend configuration. This project currently uses the same restricted anon key.
# Do not place a service-role key in any VITE_* variable.
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SPORTAI_MAX_UPLOAD_BYTES=104857600
